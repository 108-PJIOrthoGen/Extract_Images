OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=~anthropic/claude-haiku-latest

# Tốc độ: route tới provider nhanh nhất ("throughput") + timeout (giây) tránh treo.
OPENROUTER_PROVIDER_SORT=throughput
VLM_TIMEOUT_CONNECT=10
VLM_TIMEOUT_READ=180

# PDF hybrid: trang co >= PDF_TEXT_MIN_CHARS ky tu text -> gui dang TEXT (chinh xac, re);
# trang scan (it/khong co text) -> render thanh anh @ PDF_RENDER_DPI roi gui cho VLM.
PDF_TEXT_MIN_CHARS=100
PDF_RENDER_DPI=150

# Completeness: khi da trich xuat duoc data nhung ti le dien < nguong nay (0..1)
# -> bat co low_fill_rate + warning (nghi con thieu phieu hoac anh kho doc).
LOW_FILL_RATE_THRESHOLD=0.5

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=image_processing
